root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Исторические STM32/IAR файлы. CP1251 не входит в стандарт EditorConfig;
# для Src/main.c при необходимости выбрать Windows-1251 вручную в редакторе.
[{Src,Inc,Drivers,EWARM}/**.{c,h}]
charset = unset
end_of_line = crlf

[Src/{modbus_port,modbus_registers,snapshot_registers,encoder_calibration}.c]
charset = utf-8
end_of_line = lf

[Inc/{modbus_board,port,snapshot_registers,encoder_protocol,encoder_calibration}.h]
charset = utf-8
end_of_line = lf
