# Исторические исходники STM32 (в частности Src/main.c) используют CP1251.
# Новые файлы протокола явно сохранены в UTF-8, чтобы кириллица отображалась
# в GitHub и редакторах без ручного выбора кодировки.
root = true

[*]
charset = windows-1251
end_of_line = crlf
insert_final_newline = true

[*.{md,json,yml,yaml,xml}]
charset = utf-8

[Src/{modbus_port,modbus_registers,modbus_calib,snapshot_registers}.c]
charset = utf-8
end_of_line = lf

[Inc/{encoder_vars,modbus_board,modbus_calib,port,snapshot_registers}.h]
charset = utf-8
end_of_line = lf

[esp32_master/**]
charset = utf-8
end_of_line = lf

# Хостовые тесты, утилиты и скрипты — UTF-8/LF (IAR их не собирает).
[tests/**.{c,h,py,sh}]
charset = utf-8
end_of_line = lf

[tools/**.py]
charset = utf-8
end_of_line = lf

