#Generating source browse information for project taos


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.3\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.3\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.3\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build main.pbi : index main.xcl
build stm32f7xx_hal_msp.pbi : index stm32f7xx_hal_msp.xcl
build stm32f7xx_it.pbi : index stm32f7xx_it.xcl
build arm_common_tables.pbi : index arm_common_tables.xcl
build arm_sin_f32.pbi : index arm_sin_f32.xcl
build system_stm32f7xx.pbi : index system_stm32f7xx.xcl
build stm32f7xx_hal.pbi : index stm32f7xx_hal.xcl
build stm32f7xx_hal_cortex.pbi : index stm32f7xx_hal_cortex.xcl
build stm32f7xx_hal_dac.pbi : index stm32f7xx_hal_dac.xcl
build stm32f7xx_hal_dma.pbi : index stm32f7xx_hal_dma.xcl
build stm32f7xx_hal_dma_ex.pbi : index stm32f7xx_hal_dma_ex.xcl
build stm32f7xx_hal_exti.pbi : index stm32f7xx_hal_exti.xcl
build stm32f7xx_hal_flash.pbi : index stm32f7xx_hal_flash.xcl
build stm32f7xx_hal_flash_ex.pbi : index stm32f7xx_hal_flash_ex.xcl
build stm32f7xx_hal_gpio.pbi : index stm32f7xx_hal_gpio.xcl
build stm32f7xx_hal_i2c.pbi : index stm32f7xx_hal_i2c.xcl
build stm32f7xx_hal_i2c_ex.pbi : index stm32f7xx_hal_i2c_ex.xcl
build stm32f7xx_hal_pwr.pbi : index stm32f7xx_hal_pwr.xcl
build stm32f7xx_hal_pwr_ex.pbi : index stm32f7xx_hal_pwr_ex.xcl
build stm32f7xx_hal_rcc.pbi : index stm32f7xx_hal_rcc.xcl
build stm32f7xx_hal_rcc_ex.pbi : index stm32f7xx_hal_rcc_ex.xcl
build stm32f7xx_hal_tim.pbi : index stm32f7xx_hal_tim.xcl
build stm32f7xx_hal_tim_ex.pbi : index stm32f7xx_hal_tim_ex.xcl
build stm32f7xx_ll_adc.pbi : index stm32f7xx_ll_adc.xcl
build stm32f7xx_ll_dac.pbi : index stm32f7xx_ll_dac.xcl
build stm32f7xx_ll_dma.pbi : index stm32f7xx_ll_dma.xcl
build stm32f7xx_ll_exti.pbi : index stm32f7xx_ll_exti.xcl
build stm32f7xx_ll_gpio.pbi : index stm32f7xx_ll_gpio.xcl
build stm32f7xx_ll_rcc.pbi : index stm32f7xx_ll_rcc.xcl
build stm32f7xx_ll_spi.pbi : index stm32f7xx_ll_spi.xcl
build stm32f7xx_ll_utils.pbi : index stm32f7xx_ll_utils.xcl
build taos_part0.pbi : link main.pbi stm32f7xx_hal_msp.pbi stm32f7xx_it.pbi arm_common_tables.pbi arm_sin_f32.pbi system_stm32f7xx.pbi
build taos_part1.pbi : link stm32f7xx_hal.pbi stm32f7xx_hal_cortex.pbi stm32f7xx_hal_dac.pbi stm32f7xx_hal_dma.pbi stm32f7xx_hal_dma_ex.pbi stm32f7xx_hal_exti.pbi
build taos_part2.pbi : link stm32f7xx_hal_flash.pbi stm32f7xx_hal_flash_ex.pbi stm32f7xx_hal_gpio.pbi stm32f7xx_hal_i2c.pbi stm32f7xx_hal_i2c_ex.pbi stm32f7xx_hal_pwr.pbi
build taos_part3.pbi : link stm32f7xx_hal_pwr_ex.pbi stm32f7xx_hal_rcc.pbi stm32f7xx_hal_rcc_ex.pbi stm32f7xx_hal_tim.pbi stm32f7xx_hal_tim_ex.pbi stm32f7xx_ll_adc.pbi
build taos_part4.pbi : link stm32f7xx_ll_dac.pbi stm32f7xx_ll_dma.pbi stm32f7xx_ll_exti.pbi stm32f7xx_ll_gpio.pbi stm32f7xx_ll_rcc.pbi stm32f7xx_ll_spi.pbi
build taos_part5.pbi : link stm32f7xx_ll_utils.pbi
build taos.pbd : link taos_part0.pbi taos_part1.pbi taos_part2.pbi taos_part3.pbi taos_part4.pbi taos_part5.pbi
build taos.pbw : browsedata taos.pbd


