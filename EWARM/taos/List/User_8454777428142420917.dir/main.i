unsigned short crc_16_step( unsigned char data, unsigned short crc )
{
  unsigned short r;
    
  
  r=crc_16_table[crc&0xF];
  crc=(crc>>4)&0x0FFF;
  crc=crc^r^crc_16_table[data&0xF];
  
  r=crc_16_table[crc&0xF];
  crc=(crc>>4)&0x0FFF;
  crc=crc^r^crc_16_table[(data>>4)&0xF];
    
  return(crc);
}





