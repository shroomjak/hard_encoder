unsigned short get_pix(float pos) {
  if((pos<0)||(pos>127)) return -1;
  int left=(int)floor(pos);
  int right=(int)ceil(pos);
  float k=pos-left;
  int dif=(int)((buf_x1[right]-buf_x1[left])*k);
  return (dif+buf_x1[left]);

}

















 
 
