  __intrinsic int __iar_FPclassify32(float x)
  {
    if (!__iar_isfinite32(x))
    {
      if (__iar_isnan32(x))
      {
        return __kNan;
      }
      return __kInfinity;
    }
    if (__iar_iszero32(x))
    {
      return __kZero;
    }
    if (__iar_issubnormal32(x))
    {
      return __kDenorm;
    }
    return __kFinite;
  }

